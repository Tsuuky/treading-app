# Mode d'exécution: MOCK (par défaut recommandé) ou LIVE
MODE=MOCK

# Clés providers (laisser vide en mode MOCK)
ALPHAVANTAGE_API_KEY=
COINGECKO_API_KEY=

# Base WS Binance (utilisé pour stratégie live si activée)
BINANCE_WS_BASE=wss://stream.binance.com:9443

# Cache TTL (secondes)
CACHE_TTL_QUOTE_SECONDS=15
CACHE_TTL_DAILY_SECONDS=300

# Rate limiting token buckets (valeurs conservatrices)
RATE_LIMIT_PROVIDER_CAP=20
RATE_LIMIT_PROVIDER_REFILL=1
RATE_LIMIT_ROUTE_CAP=100
RATE_LIMIT_ROUTE_REFILL=3
RATE_LIMIT_CLIENT_CAP=30
RATE_LIMIT_CLIENT_REFILL=1

# Redis optionnel (laisser vide si non utilisé)
REDIS_URL=

# Paramètres simulation
FEE_BPS=5
SLIPPAGE_BPS=8
